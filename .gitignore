# Dependencies
node_modules
.pnpm-store
.npm

# Build outputs
dist
.next
.astro
.turbo
.cache
.tmp
out
storybook-static

# Environment
.env
.env*.local

# Agent eval submissions and local prepared fixtures
evals/agent/runs/**
!evals/agent/runs/.gitkeep
evals/agent/.prepared/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode
.idea
*.swp
*.swo

# Lyse local cache (baseline.json is tracked)
.lyse/*
!.lyse/baseline.json

# Local editor and browser-agent artifacts
.cursor/settings.json
.playwright-cli/
.playwright-mcp/

# Local temporary playgrounds
playground/

# Extra distribution notices generated by each package prepack hook
/packages/*/licensing/

# Hosted upstream notice staged from each app dependency at build time
/apps/*/public/third-party/PHOSPHOR-LICENSE.txt

# Local visual-regression evidence
/output/playwright/
/output/icon-regression/
