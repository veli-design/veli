{
  "name": "@veli-design/cli",
  "version": "0.2.2",
  "description": "Install and manage application-owned Veli Blocks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veli-design/veli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://veli.design",
  "bugs": {
    "url": "https://github.com/veli-design/veli/issues"
  },
  "type": "module",
  "bin": {
    "veli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "licensing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "corepack pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "corepack pnpm run build",
    "prepack": "node ../../scripts/package-licensing.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^14.0.1",
    "node-diff3": "3.2.0",
    "package-manager-detector": "^1.6.0",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "keywords": [
    "veli",
    "design-system",
    "cli",
    "blocks"
  ]
