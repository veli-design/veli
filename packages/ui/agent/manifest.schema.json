{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tradenetcorp/veli/blob/main/packages/ui/agent/manifest.schema.json",
  "title": "Veli UI agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "system", "sources", "groups"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "framework", "language", "packages", "supportedLanguages"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "const": "React"
        },
        "language": {
          "const": "TypeScript"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ui", "tokens"],
          "properties": {
            "ui": {
              "const": "@tradenetcorp/veli-ui"
            },
            "tokens": {
              "const": "@tradenetcorp/veli-tokens"
            }
          }
        },
        "supportedLanguages": {
          "type": "array",
          "prefixItems": [
            {
              "const": "en"
            },
            {
              "const": "dv"
            }
          ],
          "items": false
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentApi", "tokens", "tailwind", "css"],
      "properties": {
        "componentApi": {
          "const": "Published TypeScript declarations"
        },
        "tokens": {
          "const": "@tradenetcorp/veli-tokens/tokens"
        },
        "tailwind": {
          "const": "@tradenetcorp/veli-tokens/tailwind"
        },
        "css": {
          "const": "@tradenetcorp/veli-tokens/css"
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "components"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/component"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "importPath", "declaration", "metadata"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "importPath": {
          "type": "string",
          "pattern": "^@tradenetcorp/veli-ui/[a-z0-9-]+$"
        },
        "declaration": {
          "type": "string",
          "pattern": "^\\.\\./dist/[a-z0-9-]+\\.d\\.ts$"
        },
        "metadata": {
          "type": "string",
          "pattern": "^\\./components/[a-z0-9-]+\\.json$"
        }
      }
    }
  }
}
