{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/veli-design/veli/blob/main/packages/react/agent/component.schema.json",
  "title": "Veli UI component semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "apiPattern",
    "purpose",
    "runtime",
    "useWhen",
    "avoidWhen",
    "supportedInteractions",
    "approvedPatterns",
    "limitations",
    "accessibility",
    "responsive",
    "rtl",
    "relatedComponents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "apiPattern": {
      "enum": ["flat", "data-driven", "compound", "multi-part", "provider"]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientComponent", "provider"],
      "properties": {
        "clientComponent": {
          "type": "boolean"
        },
        "provider": {
          "enum": ["required", "recommended", "optional"]
        },
        "notes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "useWhen": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "avoidWhen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["situation", "guidance"],
        "properties": {
          "situation": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          },
          "useInstead": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "supportedInteractions": {
      "$ref": "#/$defs/stringList"
    },
    "approvedPatterns": {
      "$ref": "#/$defs/stringList"
    },
    "limitations": {
      "$ref": "#/$defs/stringList"
    },
    "accessibility": {
      "$ref": "#/$defs/stringList"
    },
    "responsive": {
      "$ref": "#/$defs/stringList"
    },
    "rtl": {
      "$ref": "#/$defs/stringList"
    },
    "relatedComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
