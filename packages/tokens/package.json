{
  "name": "@tradenetcorp/veli-tokens",
  "version": "0.10.0",
  "description": "Design tokens for the Veli Design System in CSS, Tailwind, and DTCG formats.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradenetcorp/veli.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/tradenetcorp/veli/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/tradenetcorp/veli/issues"
  },
  "type": "module",
  "main": "./dist/tailwind-theme.css",
  "exports": {
    ".": {
      "import": "./dist/tailwind-theme.css"
    },
    "./tokens": "./dist/tokens.json",
    "./css": "./dist/tokens.css",
    "./tailwind": "./dist/tailwind-theme.css",
    "./motion-tokens": "./dist/motion.tokens.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "corepack pnpm run build",
    "test": "node --test tests/*.test.mjs",
    "tokens:sync": "node build.mjs sync",
    "tokens:check": "node build.mjs check"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/token-tools": "2.7.1",
    "colorjs.io": "0.7.1",
    "prettier": "3.8.3"
  },
  "publishConfig": {
    "@tradenetcorp:registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
