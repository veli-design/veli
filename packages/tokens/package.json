{
  "name": "@veli-design/tokens",
  "version": "0.11.1",
  "description": "Design tokens for the Veli Design System in CSS, Tailwind, and DTCG formats.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veli-design/veli.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://veli.design",
  "bugs": {
    "url": "https://github.com/veli-design/veli/issues"
  },
  "type": "module",
  "main": "./dist/tailwind-theme.css",
  "exports": {
    ".": {
      "import": "./dist/tailwind-theme.css"
    },
    "./tokens": "./dist/tokens.json",
    "./css": "./dist/tokens.css",
    "./tailwind": "./dist/tailwind-theme.css",
    "./motion-tokens": "./dist/motion.tokens.json"
  },
  "files": [
    "dist",
    "licensing"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "corepack pnpm run build",
    "test": "node --test tests/*.test.mjs",
    "tokens:sync": "node build.mjs sync",
    "tokens:check": "node build.mjs check",
    "prepack": "node ../../scripts/package-licensing.mjs"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/token-tools": "2.7.1",
    "colorjs.io": "0.7.1",
    "prettier": "3.8.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "keywords": [
    "veli",
    "design-system",
    "design-tokens",
    "css",
    "tailwindcss"
  ]
}
