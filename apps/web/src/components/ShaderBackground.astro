---
/** The designer's exact Stipple BG renderer, hosted as the homepage background. */
interface Props {
  fallbackSrc?: string;
  class?: string;
}

const { fallbackSrc, class: className = '' } = Astro.props;
---

<div class:list={['shader-bg', className]} data-stipple-bg data-shader="veli-gradient-stipple">
  <iframe
    class="shader-bg__iframe"
    data-gradient-stipple-frame
    src="/gradient-stipple.html?embedded=1"
    title="Veli Stipple BG"></iframe>
  {
    fallbackSrc ? (
      <img class="shader-bg__fallback" src={fallbackSrc} alt="" aria-hidden="true" />
    ) : (
      <div class="shader-bg__fallback" aria-hidden="true" />
    )
  }
</div>

<script>
  type ValueFolder = Record<string, unknown>;
  type DialValues = { originalStipple?: ValueFolder };

  function exactPreset(values: DialValues) {
    const exact = values.originalStipple ?? {};
    return {
      version: 1,
      shader: 'veli-gradient-stipple',
      scene: Number(exact.scene ?? 0),
      controls: {
        ...((exact.sceneTiming ?? {}) as ValueFolder),
        ...((exact.motion ?? {}) as ValueFolder),
        ...((exact.lightDance ?? {}) as ValueFolder),
        ...((exact.stipple ?? {}) as ValueFolder),
      },
      sceneAdjustments: ['wave', 'dune', 'shore'].map(
        (scene) => (exact[scene] as ValueFolder | undefined) ?? {},
      ),
    };
  }

  for (const wrapper of document.querySelectorAll<HTMLElement>('[data-stipple-bg]')) {
    const frame = wrapper.querySelector<HTMLIFrameElement>('[data-gradient-stipple-frame]');
    if (!frame) continue;
    const stippleFrame = frame;
    let latestDialValues: DialValues | null = null;

    function post(message: unknown) {
      stippleFrame.contentWindow?.postMessage(message, window.location.origin);
    }

    function applyChanges(changedPaths: string[]) {
      if (!latestDialValues) return;
      const exact = latestDialValues.originalStipple ?? {};
      if (changedPaths.length !== 1) {
        post({ type: 'veli:stipple:apply-preset', preset: exactPreset(latestDialValues) });
        return;
      }
      const path = changedPaths[0];
      const parts = path.split('.');
      if (path === 'originalStipple.scene') {
        post({ type: 'veli:stipple:set-scene', scene: Number(exact.scene) });
      } else if (parts[0] === 'originalStipple' && parts.length === 3) {
        const [, group, key] = parts;
        if (['wave', 'dune', 'shore'].includes(group)) {
          post({
            type: 'veli:stipple:set-adjustment',
            scene: ['wave', 'dune', 'shore'].indexOf(group),
            key,
            value: (exact[group] as ValueFolder | undefined)?.[key],
          });
        } else {
          post({
            type: 'veli:stipple:set-control',
            key,
            value: (exact[group] as ValueFolder | undefined)?.[key],
          });
        }
      }
    }

    const onDialChange = (event: Event) => {
      const detail = (event as CustomEvent).detail as {
        values?: DialValues;
        changedPaths?: string[];
      };
      if (!detail?.values) return;
      latestDialValues = detail.values;
      applyChanges(detail.changedPaths ?? []);
    };

    const onFrameMessage = (event: MessageEvent) => {
      if (
        event.origin !== window.location.origin ||
        event.source !== stippleFrame.contentWindow ||
        event.data?.type !== 'veli:stipple:ready'
      )
        return;
      wrapper.dataset.shaderActive = 'true';
      if (latestDialValues) {
        post({ type: 'veli:stipple:apply-preset', preset: exactPreset(latestDialValues) });
      }
    };

    window.addEventListener('veli:stipple-dial-change', onDialChange);
    window.addEventListener('message', onFrameMessage);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('veli:stipple-dial-change', onDialChange);
        window.removeEventListener('message', onFrameMessage);
      },
      { once: true },
    );
  }
</script>

<style>
  .shader-bg__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #050a10;
  }
</style>
