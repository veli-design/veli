---
interface Props {
  fallbackSrc?: string;
  class?: string;
}

const { fallbackSrc, class: className = '' } = Astro.props;
---

<div class:list={['shader-bg', className]} data-wave-formation-bg data-shader="veli-wave-formation">
  <iframe
    class="shader-bg__iframe"
    data-wave-formation-frame
    src="/wave-formation.html?embedded=1"
    title="Veli WaveFormation background"
    tabindex="-1"></iframe>
  {
    fallbackSrc ? (
      <img class="shader-bg__fallback" src={fallbackSrc} alt="" aria-hidden="true" />
    ) : (
      <div class="shader-bg__fallback" aria-hidden="true" />
    )
  }
</div>

<script>
  type EngineState = Record<string, unknown>;
  const BRIDGE_VERSION = 2;

  for (const wrapper of document.querySelectorAll<HTMLElement>('[data-wave-formation-bg]')) {
    const frame = wrapper.querySelector<HTMLIFrameElement>('[data-wave-formation-frame]');
    if (!frame) continue;
    const waveFormationFrame = frame;
    let latestState: EngineState | null = null;

    function postState() {
      if (!latestState) return;
      waveFormationFrame.contentWindow?.postMessage(
        {
          type: 'veli:wave-formation:apply-state',
          version: BRIDGE_VERSION,
          state: latestState,
        },
        window.location.origin,
      );
    }

    function requestReady() {
      waveFormationFrame.contentWindow?.postMessage(
        { type: 'veli:wave-formation:request-ready', version: BRIDGE_VERSION },
        window.location.origin,
      );
    }

    const onDialChange = (event: Event) => {
      const detail = (event as CustomEvent<{ state?: EngineState }>).detail;
      if (!detail?.state) return;
      latestState = detail.state;
      postState();
    };

    const onFrameMessage = (event: MessageEvent) => {
      if (
        event.origin !== window.location.origin ||
        event.source !== waveFormationFrame.contentWindow ||
        event.data?.type !== 'veli:wave-formation:ready' ||
        event.data?.version !== BRIDGE_VERSION
      ) {
        return;
      }
      wrapper.dataset.shaderActive = 'true';
      postState();
    };

    window.addEventListener('veli:wave-formation-dial-change', onDialChange);
    window.addEventListener('message', onFrameMessage);
    waveFormationFrame.addEventListener('load', requestReady);
    requestReady();
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('veli:wave-formation-dial-change', onDialChange);
        window.removeEventListener('message', onFrameMessage);
        waveFormationFrame.removeEventListener('load', requestReady);
      },
      { once: true },
    );
  }
</script>

<style>
  .shader-bg__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--veli-color-bg-surface-base);
  }
</style>
