<script>
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';
  import { DocsCodeExpandButton } from './DocsCodeExpandButton';
  import { observeDocsPreviewCode } from '../lib/docs-preview-code.mjs';

  const copyIcon = `
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M7.5 6.5h7a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z" />
      <path d="M4.5 12.5h-1a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1" />
    </svg>
  `;

  const checkIcon = `
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="m4 10.5 3.5 3.5L16 5.5" />
    </svg>
  `;

  function copyWithFallback(value: string) {
    const previouslyFocused = document.activeElement;
    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();

    try {
      const legacyDocument = document as unknown as {
        execCommand(commandId: string): boolean;
      };
      return legacyDocument.execCommand('copy');
    } finally {
      textarea.remove();
      if (previouslyFocused instanceof HTMLElement) previouslyFocused.focus();
    }
  }

  async function copyCode(value: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        // Clipboard access can be unavailable in embedded or non-secure contexts.
      }
    }

    try {
      return copyWithFallback(value);
    } catch {
      return false;
    }
  }

  for (const wrapper of document.querySelectorAll<HTMLElement>('.docs-code-block')) {
    const pre = wrapper.querySelector('pre');
    const code = pre?.querySelector('code');
    const languageLabel =
      wrapper.querySelector('.docs-code-block__language')?.textContent || 'code';
    const button = wrapper.querySelector<HTMLButtonElement>('.docs-code-block__copy');
    const buttonLabel = button?.querySelector('span');
    const status = wrapper.querySelector<HTMLElement>('.docs-code-block__status');
    if (!pre || !code || !button || !buttonLabel || !status) continue;

    let resetTimer: number | undefined;

    const tabs = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const selectTab = (tab: HTMLButtonElement) => {
      for (const item of tabs) {
        item.setAttribute('aria-selected', String(item === tab));
        item.tabIndex = item === tab ? 0 : -1;
      }
      code.textContent = tab.dataset.command || '';
      pre.setAttribute('aria-labelledby', tab.id);
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const next =
          event.key === 'ArrowRight'
            ? (index + 1) % tabs.length
            : event.key === 'ArrowLeft'
              ? (index + tabs.length - 1) % tabs.length
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? tabs.length - 1
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        selectTab(tabs[next]);
        tabs[next].focus();
      });
    }

    button.addEventListener('click', async () => {
      window.clearTimeout(resetTimer);
      button.disabled = true;
      const copied = await copyCode(code.textContent || '');

      button.disabled = false;
      button.dataset.state = copied ? 'copied' : 'error';
      const statusMessage = copied
        ? `${languageLabel} code copied`
        : `Unable to copy ${languageLabel} code, try again`;
      button.setAttribute('aria-label', statusMessage);
      button.querySelector('svg')?.remove();
      button.insertAdjacentHTML('afterbegin', copied ? checkIcon : copyIcon);
      buttonLabel.textContent = copied ? 'Copied' : 'Try again';
      status.textContent = '';
      window.setTimeout(() => {
        status.textContent = statusMessage;
      });

      resetTimer = window.setTimeout(() => {
        button.dataset.state = 'idle';
        button.setAttribute('aria-label', `Copy ${languageLabel} code`);
        button.querySelector('svg')?.remove();
        button.insertAdjacentHTML('afterbegin', copyIcon);
        buttonLabel.textContent = 'Copy';
      }, 2000);
    });

    const expandControl = wrapper.querySelector<HTMLElement>('.docs-code-block__expand');
    if (expandControl) {
      createRoot(expandControl).render(
        createElement(DocsCodeExpandButton, {
          pre,
          wrapper,
          lineCount: Number(expandControl.dataset.lineCount),
        }),
      );
    }
  }

  observeDocsPreviewCode(document);
</script>

