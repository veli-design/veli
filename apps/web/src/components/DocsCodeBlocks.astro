    );
    padding: 24px 8px 8px;
  }

  .docs-code-block.is-collapsible.is-expanded .docs-code-block__expand {
    min-height: auto;
    align-items: center;
    margin-top: 0;
    border-top: 1px solid
      color-mix(
        in srgb,
        var(--docs-code-block-color, var(--color-text-base-inverted)) 18%,
        transparent
      );
    background: transparent;
    padding: 8px;
  }

  .docs-code-block__expand-button {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 6px;
    border-radius: 5px;
    background: color-mix(in srgb, currentColor 12%, transparent);
    color: inherit;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    cursor: pointer;
    transition: background-color 140ms ease;
  }

  .docs-code-block__expand-button:hover {
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  .docs-code-block__expand-button:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 1px;
  }

  .docs-code-block__expand-button svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 140ms ease;
  }

  .docs-code-block.is-expanded .docs-code-block__expand-button svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-code-block__expand-button svg {
      transition: none;
    }
  }
</style>
