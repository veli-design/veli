---
interface Props {
  src: string;
  srcDark: string;
  lottie: string;
  lottieDark?: string;
}

const { src, srcDark, lottie, lottieDark } = Astro.props;
const usesSharedLottie = !lottieDark;
---

<span
  class="docs-page-header__art"
  aria-hidden="true"
  data-foundation-header-art
  data-lottie-src={lottie}
  data-lottie-src-dark={lottieDark}
>
  {/* Native dotted plate — replaces baked Lottie BG; hidden when PNG fallback is shown. */}
  <span class="docs-page-header__art-bg"></span>
  <img
    class="docs-page-header__art-image docs-page-header__art-image--light"
    src={src}
    alt=""
    width="195"
    height="195"
  />
  <img
    class="docs-page-header__art-image docs-page-header__art-image--dark"
    src={srcDark}
    alt=""
    width="195"
    height="195"
  />
  {
    usesSharedLottie ? (
      <canvas
        class="docs-page-header__art-lottie docs-page-header__art-lottie--shared"
        data-foundation-lottie="shared"
      />
    ) : (
      <>
        <canvas
          class="docs-page-header__art-lottie docs-page-header__art-lottie--light"
          data-foundation-lottie="light"
        />
        <canvas
          class="docs-page-header__art-lottie docs-page-header__art-lottie--dark"
          data-foundation-lottie="dark"
        />
      </>
    )
  }
</span>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';
  import wasmUrl from '@lottiefiles/dotlottie-web/dotlottie-player.wasm?url';

  type HeaderArtRoot = HTMLElement & {
    dataset: DOMStringMap & {
      lottieSrc?: string;
      lottieSrcDark?: string;
      lottieMounted?: string;
    };
  };

  type MountState = {
    expected: number;
    failed: number;
  };

  const players = new WeakMap<HTMLCanvasElement, DotLottie>();
  let wasmConfigured = false;

  function ensureWasm() {
    if (wasmConfigured) return;
    DotLottie.setWasmUrl(wasmUrl);
    wasmConfigured = true;
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function showFallback(root: HeaderArtRoot) {
    root.classList.add('is-fallback');
  }

  function destroyPlayer(canvas: HTMLCanvasElement) {
    const player = players.get(canvas);
    if (!player) return;
    player.destroy();
    players.delete(canvas);
    canvas.classList.remove('is-ready');
  }

  function observeCanvasSize(canvas: HTMLCanvasElement, player: DotLottie) {
    if (typeof ResizeObserver === 'undefined') return;

    const observer = new ResizeObserver(() => {
      if (canvas.clientWidth > 0 && canvas.clientHeight > 0) {
        player.resize();
      }
    });
    observer.observe(canvas);
    player.addEventListener('destroy', () => observer.disconnect());
  }

  function mountPlayer(
    canvas: HTMLCanvasElement,
    src: string,
    root: HeaderArtRoot,
    state: MountState,
  ) {
    if (!src || players.has(canvas)) return;

    const player = new DotLottie({
      canvas,
      src,
      autoplay: true,
      loop: false,
      layout: { fit: 'contain', align: [0.5, 0.5] },
    });

    players.set(canvas, player);
    observeCanvasSize(canvas, player);

    const markReady = () => {
      canvas.classList.add('is-ready');
    };

    player.addEventListener('ready', markReady);
    player.addEventListener('load', markReady);
    player.addEventListener('loadError', (event) => {
      console.error('[FoundationHeaderArt] Failed to load Lottie', src, event);
      destroyPlayer(canvas);
      state.failed += 1;
      if (state.failed >= state.expected) {
        showFallback(root);
      }
    });
  }

  function initHeaderArt(root: HeaderArtRoot) {
    if (root.dataset.lottieMounted === 'true') return;
    root.dataset.lottieMounted = 'true';
    root.classList.remove('is-fallback');

    if (prefersReducedMotion()) {
      showFallback(root);
      return;
    }

    ensureWasm();

    const lightSrc = root.dataset.lottieSrc;
    const darkSrc = root.dataset.lottieSrcDark;
    if (!lightSrc) {
      showFallback(root);
      return;
    }

    const sharedCanvas = root.querySelector<HTMLCanvasElement>('[data-foundation-lottie="shared"]');
    if (sharedCanvas) {
      mountPlayer(sharedCanvas, lightSrc, root, { expected: 1, failed: 0 });
      return;
    }

    const lightCanvas = root.querySelector<HTMLCanvasElement>('[data-foundation-lottie="light"]');
    const darkCanvas = root.querySelector<HTMLCanvasElement>('[data-foundation-lottie="dark"]');
    const state = {
      expected: Number(Boolean(lightCanvas)) + Number(Boolean(darkCanvas && darkSrc)),
      failed: 0,
    };

    if (state.expected === 0) {
      showFallback(root);
      return;
    }

    if (lightCanvas) mountPlayer(lightCanvas, lightSrc, root, state);
    if (darkCanvas && darkSrc) mountPlayer(darkCanvas, darkSrc, root, state);
  }

  function initAll() {
    for (const root of document.querySelectorAll<HeaderArtRoot>('[data-foundation-header-art]')) {
      initHeaderArt(root);
    }
  }

  function destroyAll() {
    for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-foundation-lottie]')) {
      destroyPlayer(canvas);
      const root = canvas.closest<HeaderArtRoot>('[data-foundation-header-art]');
      if (root) {
        delete root.dataset.lottieMounted;
        root.classList.remove('is-fallback');
      }
    }
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', destroyAll);
</script>
