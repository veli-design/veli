---
interface Props {
  src: string;
  darkSrc?: string;
  alt: string;
  width: string;
  height: string;
  caption?: string;
}
const { src, darkSrc, alt, width, height, caption } = Astro.props;
---

<figure class="docs-figure">
  <img
    class:list={[darkSrc && 'docs-figure__light']}
    {src}
    {alt}
    {width}
    {height}
    loading="lazy"
    decoding="async"
  />
  {darkSrc && (
    <img
      class="docs-figure__dark"
      src={darkSrc}
      {alt}
      {width}
      {height}
      loading="lazy"
      decoding="async"
    />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
