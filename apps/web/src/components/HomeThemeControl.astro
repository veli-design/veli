---
import DocsPhosphorIcon from './DocsPhosphorIcon.astro';
const themeChoices = [
  { id: 'light', icon: 'sun' },
  { id: 'dark', icon: 'moon' },
  { id: 'system', icon: 'monitor' },
] as const;
---

<button class="home-theme-cycle" type="button" aria-label="Use system theme" data-theme-cycle>
  {
    themeChoices.map((choice) => {
      return <DocsPhosphorIcon name={choice.icon} data-theme-icon={choice.id} />;
    })
  }
  <span class="home-theme-cycle__tooltip" aria-hidden="true" data-theme-label>
    Use system theme
  </span>
</button>
