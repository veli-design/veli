---
import '../styles/global.css';
import DialKitRoot from '../components/DialKitRoot';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  markdownPath?: string;
}

const {
  title,
  description = 'Veli Design System documentation and foundations.',
  pageClass = '',
  markdownPath,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-color-scheme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link data-veli-favicon rel="icon" type="image/svg+xml" href="/favicon-dark.svg" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="describedby" href="/llms.txt" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'veli-color-scheme';
        const root = document.documentElement;

        try {
          const stored = window.localStorage.getItem(storageKey);
          const colorScheme =
            stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
          const isDark =
            colorScheme === 'dark' ||
            (colorScheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          const resolvedColorScheme = isDark ? 'dark' : 'light';

          root.classList.toggle('dark', isDark);
          root.dataset.theme = resolvedColorScheme;
          root.dataset.colorScheme = colorScheme;
          root.style.colorScheme = resolvedColorScheme;
          const favicon = document.querySelector('[data-veli-favicon]');
          if (favicon instanceof HTMLLinkElement) {
            favicon.href = isDark ? '/favicon-light.svg' : '/favicon-dark.svg';
          }
        } catch {
          root.dataset.theme = 'light';
          root.dataset.colorScheme = 'system';
          root.style.colorScheme = 'light';
        }
      })();
    </script>
  </head>
  <body class:list={['min-h-screen bg-surface-base text-base', pageClass]}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
    <DialKitRoot client:load />

    <script is:inline>
      (() => {
        const storageKey = 'veli-color-scheme';
        const choices = ['light', 'dark', 'system'];
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const buttons = Array.from(document.querySelectorAll('[data-theme-choice]'));
        const cycleButtons = Array.from(document.querySelectorAll('[data-theme-cycle]'));
        const cycleLabels = Array.from(document.querySelectorAll('[data-theme-label]'));
        const themeLabels = {
          light: 'Light theme',
          dark: 'Dark theme',
          system: 'Use system theme',
        };

        function getStoredColorScheme() {
          try {
            const stored = window.localStorage.getItem(storageKey);
            return choices.includes(stored) ? stored : 'system';
          } catch {
            return 'system';
          }
        }

        function applyColorScheme(colorScheme) {
          const isDark = colorScheme === 'dark' || (colorScheme === 'system' && media.matches);
          const resolvedColorScheme = isDark ? 'dark' : 'light';
          const previousResolvedColorScheme = root.dataset.theme;

          root.classList.toggle('dark', isDark);
          root.dataset.theme = resolvedColorScheme;
          root.dataset.colorScheme = colorScheme;
          root.style.colorScheme = resolvedColorScheme;
          const favicon = document.querySelector('[data-veli-favicon]');
          if (favicon instanceof HTMLLinkElement) {
            favicon.href = isDark ? '/favicon-light.svg' : '/favicon-dark.svg';
          }

          window.dispatchEvent(
            new CustomEvent('veli:color-scheme-change', {
              detail: { colorScheme, resolvedColorScheme, previousResolvedColorScheme },
            }),
          );

          for (const button of buttons) {
            const isActive = button.dataset.themeChoice === colorScheme;
            button.setAttribute('aria-pressed', String(isActive));
          }

          for (const cycleButton of cycleButtons) {
            const label = themeLabels[colorScheme];
            cycleButton.setAttribute('aria-label', label);
          }

          for (const cycleLabel of cycleLabels) {
            cycleLabel.textContent = themeLabels[colorScheme];
          }
        }

        for (const button of buttons) {
          button.addEventListener('click', () => {
            const colorScheme = button.dataset.themeChoice;
            if (!choices.includes(colorScheme)) return;

            try {
              window.localStorage.setItem(storageKey, colorScheme);
            } catch {
              // The visual state can still update if storage is unavailable.
            }

            applyColorScheme(colorScheme);
          });
        }

        for (const cycleButton of cycleButtons) {
          cycleButton.addEventListener('click', () => {
            const current = getStoredColorScheme();
            const next = choices[(choices.indexOf(current) + 1) % choices.length];

            try {
              window.localStorage.setItem(storageKey, next);
            } catch {
              // The visual state can still update if storage is unavailable.
            }

            applyColorScheme(next);
          });
        }

        media.addEventListener('change', () => {
          if (getStoredColorScheme() === 'system') {
            applyColorScheme('system');
          }
        });

        applyColorScheme(getStoredColorScheme());
      })();
    </script>
  </body>
</html>
