---
import {
  ArrowUpRight,
  CaretDown,
  FigmaLogo,
  GithubLogo,
  List,
  Monitor,
  Moon,
  Package,
  Sun,
} from 'phosphor-react';
import DocsCodeBlocks from '../components/DocsCodeBlocks.astro';
import { DocsSearch } from '../components/DocsSearch';
import VeliLogo from '../components/VeliLogo.astro';
import { docsSections, externalResources } from '../lib/site';
import Layout from './layout.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  title: string;
  description?: string;
  activePath: string;
  headings?: Heading[];
  fullBleedHeader?: boolean;
}

const { title, description, activePath, headings = [], fullBleedHeader = false } = Astro.props;

const resourceIcons = {
  figma: FigmaLogo,
  github: GithubLogo,
  package: Package,
};

const themeChoices = [
  { id: 'light', label: 'Light theme', icon: Sun },
  { id: 'dark', label: 'Dark theme', icon: Moon },
  { id: 'system', label: 'Use system theme', icon: Monitor },
] as const;

function isActive(href: string) {
  return activePath === href;
}

function isSectionActive(section: (typeof docsSections)[number]) {
  return section.items.some((item) => isActive(item.href));
}
---

<Layout title={title} description={description} pageClass="docs-page">
  <div class="docs-workspace">
    <aside class="docs-navigation" aria-label="Documentation navigation">
      <div class="docs-navigation__scroll">
        <a class="docs-brand" href="/" aria-label="Veli Design home">
          <VeliLogo class="veli-logo" clipId="veli-logo-desktop" />
        </a>

        <div class="docs-nav-filter">
          <DocsSearch client:load />

          <nav class="docs-nav" aria-label="Veli documentation">
            {
              docsSections.map((section) => {
                const sectionActive = isSectionActive(section);
                return (
                  <details
                    class="docs-nav-group"
                    data-doc-group
                    data-default-open={sectionActive ? 'true' : undefined}
                    open={sectionActive}
                  >
                    <summary>
                      <span>{section.title}</span>
                      <CaretDown className="docs-nav-group__caret" size={16} aria-hidden="true" />
                    </summary>
                    <div class="docs-nav-group__links">
                      {section.items.map((item) => {
                        const itemActive = isActive(item.href);
                        return (
                          <a
                            class:list={['docs-nav-link', itemActive && 'is-active']}
                            href={item.href}
                            aria-current={itemActive ? 'page' : undefined}
                            data-doc-link
                          >
                            {item.title}
                          </a>
                        );
                      })}
                    </div>
                  </details>
                );
              })
            }
          </nav>
        </div>
      </div>

      <div class="docs-navigation__footer">
        <div class="docs-theme-picker" aria-label="Color theme">
          <span>Theme</span>
          <div class="docs-theme-picker__choices">
            {
              themeChoices.map((choice) => {
                const Icon = choice.icon;
                return (
                  <button
                    type="button"
                    title={choice.label}
                    aria-label={choice.label}
                    aria-pressed="false"
                    data-theme-choice={choice.id}
                  >
                    <Icon size={16} aria-hidden="true" />
                  </button>
                );
              })
            }
          </div>
        </div>

        <nav class="docs-resources" aria-label="Veli resources">
          {
            externalResources.map((item) => {
              const Icon = resourceIcons[item.icon];

              if (!item.href) {
                return (
                  <div class="docs-resource is-disabled" aria-disabled="true">
                    <Icon size={16} weight="regular" aria-hidden="true" />
                    <span>{item.label}</span>
                    <small>Coming soon</small>
                  </div>
                );
              }

              return (
                <a class="docs-resource" href={item.href} target="_blank" rel="noreferrer">
                  <Icon size={16} weight="regular" aria-hidden="true" />
                  <span>{item.label}</span>
                  <ArrowUpRight className="external-arrow" size={13} aria-hidden="true" />
                </a>
              );
            })
          }
        </nav>
      </div>
    </aside>

    <header class="docs-mobile-header">
      <a class="docs-brand" href="/" aria-label="Veli Design home">
        <VeliLogo class="veli-logo" clipId="veli-logo-mobile" />
      </a>
      <details class="docs-mobile-menu">
        <summary aria-label="Open documentation navigation">
          <List size={22} aria-hidden="true" />
        </summary>
        <div class="docs-mobile-menu__panel">
          <DocsSearch client:load enableShortcut={false} />

          <nav class="docs-mobile-nav" aria-label="Mobile documentation navigation">
            {
              docsSections.map((section) => {
                const sectionActive = isSectionActive(section);
                return (
                  <details
                    class="docs-nav-group"
                    data-doc-group
                    data-default-open={sectionActive ? 'true' : undefined}
                    open={sectionActive}
                  >
                    <summary>
                      <span>{section.title}</span>
                      <CaretDown className="docs-nav-group__caret" size={16} aria-hidden="true" />
                    </summary>
                    <div class="docs-nav-group__links">
                      {section.items.map((item) => {
                        const itemActive = isActive(item.href);
                        return (
                          <a
                            class:list={['docs-nav-link', itemActive && 'is-active']}
                            href={item.href}
                            aria-current={itemActive ? 'page' : undefined}
                            data-doc-link
                          >
                            {item.title}
                          </a>
                        );
                      })}
                    </div>
                  </details>
                );
              })
            }
          </nav>

          <div class="docs-mobile-menu__footer">
            <div class="docs-theme-picker" aria-label="Color theme">
              <span>Theme</span>
              <div class="docs-theme-picker__choices">
                {
                  themeChoices.map((choice) => {
                    const Icon = choice.icon;
                    return (
                      <button
                        type="button"
                        title={choice.label}
                        aria-label={choice.label}
                        aria-pressed="false"
                        data-theme-choice={choice.id}
                      >
                        <Icon size={16} aria-hidden="true" />
                      </button>
                    );
                  })
                }
              </div>
            </div>

            <nav class="docs-resources" aria-label="Veli resources">
              {
                externalResources.map((item) => {
                  const Icon = resourceIcons[item.icon];

                  if (!item.href) {
                    return (
                      <div class="docs-resource is-disabled" aria-disabled="true">
                        <Icon size={16} weight="regular" aria-hidden="true" />
                        <span>{item.label}</span>
                        <small>Coming soon</small>
                      </div>
                    );
                  }

                  return (
                    <a class="docs-resource" href={item.href} target="_blank" rel="noreferrer">
                      <Icon size={16} weight="regular" aria-hidden="true" />
                      <span>{item.label}</span>
                      <ArrowUpRight className="external-arrow" size={13} aria-hidden="true" />
                    </a>
                  );
                })
              }
            </nav>
          </div>
        </div>
      </details>
    </header>

    <main id="main" class:list={['docs-main', fullBleedHeader && 'docs-main--full-bleed-header']}>
      <div class="docs-main__inner">
        <slot />

        <aside class="docs-utilities" aria-label="Page utilities">
          <nav class="docs-contents" aria-label="On this page">
            <h2>On this page</h2>
            {
              headings.length > 0 ? (
                headings.map((heading) => (
                  <a class:list={[heading.depth === 3 && 'is-nested']} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))
              ) : (
                <a href="#main">Overview</a>
              )
            }
          </nav>
        </aside>
      </div>
    </main>
  </div>

  <script is:inline>
    (() => {
      const mobileMenu = document.querySelector('.docs-mobile-menu');
      const mobileMenuPanel = document.querySelector('.docs-mobile-menu__panel');

      mobileMenu?.addEventListener('toggle', () => {
        const isOpen = mobileMenu instanceof HTMLDetailsElement && mobileMenu.open;
        if (isOpen && mobileMenuPanel instanceof HTMLElement) mobileMenuPanel.scrollTop = 0;
      });

      for (const link of document.querySelectorAll('.docs-mobile-menu a')) {
        link.addEventListener('click', () => mobileMenu?.removeAttribute('open'));
      }
    })();
  </script>
  <DocsCodeBlocks />
</Layout>
