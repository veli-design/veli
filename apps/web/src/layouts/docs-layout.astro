---
import { ArrowUpRight, FigmaLogo, GithubLogo, List, Package } from 'phosphor-react';
import Layout from './layout.astro';
import { componentGroups, externalResources, foundations } from '../lib/site';
import { DocsSearch } from '../components/DocsSearch';
import VeliLogo from '../components/VeliLogo.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  title: string;
  description?: string;
  activePath: string;
  headings?: Heading[];
  fullBleedHeader?: boolean;
}

const { title, description, activePath, headings = [], fullBleedHeader = false } = Astro.props;

const resourceIcons = {
  figma: FigmaLogo,
  github: GithubLogo,
  package: Package,
};

function isActive(href: string) {
  if (href === '/docs/') return activePath === href;
  return activePath === href || activePath.startsWith(`${href}#`);
}
---

<Layout title={title} description={description} pageClass="docs-page">
  <div class="docs-workspace">
    <aside class="docs-navigation" aria-label="Documentation navigation">
      <div class="docs-navigation__scroll">
        <a class="docs-brand" href="/" aria-label="Veli Design home">
          <VeliLogo class="veli-logo" clipId="veli-logo-desktop" />
        </a>

        <nav class="docs-nav" aria-label="Veli documentation">
          <section class="docs-nav-group" data-doc-group>
            <h2>Foundations</h2>
            <a
              class:list={['docs-nav-link', isActive('/foundations/') && 'is-active']}
              href="/foundations/"
              data-doc-link
            >
              Overview
            </a>
            {
              foundations.map((item) => (
                <a
                  class:list={['docs-nav-link', isActive(item.href) && 'is-active']}
                  href={item.href}
                  data-doc-link
                >
                  {item.title}
                </a>
              ))
            }
          </section>

          <section class="docs-nav-group" data-doc-group>
            <h2>Components</h2>
            <a
              class:list={['docs-nav-link', isActive('/docs/') && 'is-active']}
              href="/docs/"
              data-doc-link
            >
              Overview
            </a>
            {
              componentGroups.flatMap((group) =>
                group.items.map((item) => (
                  <a
                    class:list={[
                      'docs-nav-link',
                      activePath === `/docs/${item.slug}/` && 'is-active',
                    ]}
                    href={`/docs/${item.slug}/`}
                    data-doc-link
                  >
                    {item.title}
                  </a>
                )),
              )
            }
          </section>
        </nav>
      </div>

      <nav class="docs-resources" aria-label="Veli resources">
        {
          externalResources.map((item) => {
            const Icon = resourceIcons[item.icon];
            return (
              <a href={item.href} target="_blank" rel="noreferrer">
                <Icon size={18} weight="regular" aria-hidden="true" />
                <span>{item.label}</span>
                <ArrowUpRight className="external-arrow" size={13} aria-hidden="true" />
              </a>
            );
          })
        }
      </nav>
    </aside>

    <header class="docs-mobile-header">
      <a class="docs-brand" href="/" aria-label="Veli Design home">
        <VeliLogo class="veli-logo" clipId="veli-logo-mobile" />
      </a>
      <details class="docs-mobile-menu">
        <summary aria-label="Open documentation navigation">
          <List size={22} aria-hidden="true" />
        </summary>
        <div class="docs-mobile-menu__panel">
          <nav aria-label="Mobile documentation navigation">
            <h2>Foundations</h2>
            <a href="/foundations/">Overview</a>
            {foundations.map((item) => <a href={item.href}>{item.title}</a>)}
            <h2>Components</h2>
            <a href="/docs/">Overview</a>
            {
              componentGroups.flatMap((group) =>
                group.items.map((item) => <a href={`/docs/${item.slug}/`}>{item.title}</a>),
              )
            }
          </nav>
        </div>
      </details>
    </header>

    <main id="main" class:list={['docs-main', fullBleedHeader && 'docs-main--full-bleed-header']}>
      <div class="docs-main__inner">
        <slot />
      </div>
    </main>

    <aside class="docs-utilities" aria-label="Page utilities">
      <DocsSearch client:load />

      <nav class="docs-contents" aria-label="On this page">
        <h2>On this page</h2>
        {
          headings.length > 0 ? (
            headings.map((heading) => (
              <a class:list={[heading.depth === 3 && 'is-nested']} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))
          ) : (
            <a href="#main">Overview</a>
          )
        }
      </nav>

      <button class="theme-cycle" type="button" data-theme-cycle>
        <span>Theme</span>
        <span data-theme-label>System</span>
      </button>
    </aside>
  </div>

  <script is:inline>
    (() => {
      const mobileMenu = document.querySelector('.docs-mobile-menu');
      const mobileMenuLinks = document.querySelectorAll('.docs-mobile-menu a');
      const mobileMenuPanel = document.querySelector('.docs-mobile-menu__panel');

      function resetMobileMenuScroll() {
        const isOpen = mobileMenu instanceof HTMLDetailsElement && mobileMenu.open;
        if (isOpen && mobileMenuPanel instanceof HTMLElement) mobileMenuPanel.scrollTop = 0;
      }

      mobileMenu?.addEventListener('toggle', resetMobileMenuScroll);

      for (const link of mobileMenuLinks) {
        link.addEventListener('click', () => mobileMenu?.removeAttribute('open'));
      }
    })();
  </script>
</Layout>
