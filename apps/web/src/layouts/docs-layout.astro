---
import { CaretDownIcon, ListIcon } from '@phosphor-icons/react';
import DocsCodeBlocks from '../components/DocsCodeBlocks.astro';
import DocsFooterControls from '../components/DocsFooterControls.astro';
import DocsPageActions from '../components/DocsPageActions.astro';
import { DocsSearch } from '../components/DocsSearch';
import VeliLogo from '../components/VeliLogo.astro';
import { docsSections } from '../lib/site';
import Layout from './layout.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type DocsContentLayout = 'overview' | 'foundation-article' | 'component' | 'article';

interface Props {
  title: string;
  description?: string;
  activePath: string;
  markdownPath?: string;
  headings?: Heading[];
  fullBleedHeader?: boolean;
  showPageActions?: boolean;
  contentLayout: DocsContentLayout;
}

const {
  title,
  description,
  activePath,
  markdownPath,
  headings = [],
  fullBleedHeader = false,
  showPageActions = true,
  contentLayout,
} = Astro.props;

function isActive(href: string) {
  return activePath === href;
}

function isSectionActive(section: (typeof docsSections)[number]) {
  return section.items.some((item) => isActive(item.href));
}
---

<Layout title={title} description={description} pageClass="docs-page" {markdownPath}>
  <div class="docs-workspace">
    <aside class="docs-navigation" aria-label="Documentation navigation">
      <div class="docs-navigation__scroll">
        <a class="docs-brand" href="/" aria-label="Veli Design home">
          <VeliLogo class="veli-logo" clipId="veli-logo-desktop" />
        </a>

        <div class="docs-nav-filter">
          <a
            class="docs-nav-link"
            href="/docs/"
            aria-current={activePath === '/docs/' ? 'page' : undefined}>Getting started</a
          >
          <DocsSearch client:load />

          <nav class="docs-nav" aria-label="Veli documentation">
            {
              docsSections.map((section) => {
                const sectionActive = isSectionActive(section);
                return (
                  <details
                    class="docs-nav-group"
                    data-doc-group
                    data-default-open={sectionActive ? 'true' : undefined}
                    open={sectionActive}
                  >
                    <summary>
                      <span>{section.title}</span>
                      <CaretDownIcon
                        className="docs-nav-group__caret"
                        size={16}
                        aria-hidden="true"
                      />
                    </summary>
                    <div class="docs-nav-group__links">
                      {section.items.map((item) => {
                        const itemActive = isActive(item.href);
                        return (
                          <a
                            class:list={['docs-nav-link', itemActive && 'is-active']}
                            href={item.href}
                            aria-current={itemActive ? 'page' : undefined}
                            data-doc-link
                          >
                            {item.title}
                          </a>
                        );
                      })}
                    </div>
                  </details>
                );
              })
            }
          </nav>
        </div>
      </div>

      <div class="docs-navigation__footer">
        <DocsFooterControls />
      </div>
    </aside>

    <header class="docs-mobile-header">
      <a class="docs-brand" href="/" aria-label="Veli Design home">
        <VeliLogo class="veli-logo" clipId="veli-logo-mobile" />
      </a>
      <details class="docs-mobile-menu">
        <summary aria-label="Open documentation navigation">
          <ListIcon size={22} aria-hidden="true" />
        </summary>
        <div class="docs-mobile-menu__panel">
          <a
            class="docs-nav-link"
            href="/docs/"
            aria-current={activePath === '/docs/' ? 'page' : undefined}>Getting started</a
          >
          <DocsSearch client:load enableShortcut={false} />

          <nav class="docs-mobile-nav" aria-label="Mobile documentation navigation">
            {
              docsSections.map((section) => {
                const sectionActive = isSectionActive(section);
                return (
                  <details
                    class="docs-nav-group"
                    data-doc-group
                    data-default-open={sectionActive ? 'true' : undefined}
                    open={sectionActive}
                  >
                    <summary>
                      <span>{section.title}</span>
                      <CaretDownIcon
                        className="docs-nav-group__caret"
                        size={16}
                        aria-hidden="true"
                      />
                    </summary>
                    <div class="docs-nav-group__links">
                      {section.items.map((item) => {
                        const itemActive = isActive(item.href);
                        return (
                          <a
                            class:list={['docs-nav-link', itemActive && 'is-active']}
                            href={item.href}
                            aria-current={itemActive ? 'page' : undefined}
                            data-doc-link
                          >
                            {item.title}
                          </a>
                        );
                      })}
                    </div>
                  </details>
                );
              })
            }
          </nav>

          <div class="docs-mobile-menu__footer">
            <DocsFooterControls />
          </div>
        </div>
      </details>
    </header>

    <main
      id="main"
      class:list={[
        'docs-main',
        fullBleedHeader && 'docs-main--full-bleed-header',
        `docs-main--${contentLayout}`,
      ]}
    >
      <div class="docs-main__inner">
        <slot />

        <aside class="docs-utilities" aria-label="Page utilities">
          <div class="docs-utilities__sticky">
            {
              markdownPath && showPageActions && (
                <DocsPageActions {markdownPath} placement="utility" />
              )
            }
            <nav class="docs-contents" aria-label="On this page">
              <h2>On this page</h2>
              {
                headings.length > 0 ? (
                  headings.map((heading) => (
                    <a class:list={[heading.depth === 3 && 'is-nested']} href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  ))
                ) : (
                  <a href="#main">Overview</a>
                )
              }
            </nav>
          </div>
        </aside>
      </div>
    </main>
  </div>

  <script is:inline>
    (() => {
      const mobileMenu = document.querySelector('.docs-mobile-menu');
      const mobileMenuPanel = document.querySelector('.docs-mobile-menu__panel');

      mobileMenu?.addEventListener('toggle', () => {
        const isOpen = mobileMenu instanceof HTMLDetailsElement && mobileMenu.open;
        if (isOpen && mobileMenuPanel instanceof HTMLElement) mobileMenuPanel.scrollTop = 0;
      });

      for (const link of document.querySelectorAll('.docs-mobile-menu a')) {
        link.addEventListener('click', () => mobileMenu?.removeAttribute('open'));
      }

      const contents = document.querySelector('.docs-contents');
      const scrollRoot = document.querySelector('.docs-main__inner');

      if (contents && scrollRoot instanceof HTMLElement) {
        const sections = [...contents.querySelectorAll('a[href^="#"]')].flatMap((link) => {
          const id = link.getAttribute('href')?.slice(1);
          const heading = id ? document.getElementById(id) : null;
          return heading ? [{ link, heading }] : [];
        });
        let activeLink;
        let updateFrame;

        const updateContents = () => {
          updateFrame = undefined;
          const rootRect = scrollRoot.getBoundingClientRect();
          const remainingScroll = Math.max(
            0,
            scrollRoot.scrollHeight - scrollRoot.clientHeight - scrollRoot.scrollTop,
          );
          const visibleSections = sections.filter(
            ({ link, heading }) => !link.hidden && !heading.closest('[hidden]'),
          );
          const activeLine = Math.max(rootRect.top + 64, rootRect.bottom - 64 - remainingScroll);
          let active = visibleSections[0];

          for (const section of visibleSections) {
            if (section.heading.getBoundingClientRect().top > activeLine) break;
            active = section;
          }

          const hashActive =
            remainingScroll <= 1 &&
            visibleSections.find(({ link, heading }) => {
              const headingRect = heading.getBoundingClientRect();
              return (
                link.getAttribute('href') === location.hash &&
                headingRect.top < rootRect.bottom &&
                headingRect.bottom > rootRect.top
              );
            });
          if (hashActive) active = hashActive;

          if (!active || active.link === activeLink) return;
          activeLink = active.link;

          for (const { link } of sections) {
            const isActive = link === activeLink;
            link.classList.toggle('is-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }

          const rail = contents;
          if (rail.clientHeight === 0) return;
          const linkRect = activeLink.getBoundingClientRect();
          const railRect = rail.getBoundingClientRect();
          if (linkRect.top < railRect.top + 8) rail.scrollTop += linkRect.top - railRect.top - 8;
          else if (linkRect.bottom > railRect.bottom - 8)
            rail.scrollTop += linkRect.bottom - railRect.bottom + 8;
        };

        const scheduleContentsUpdate = () => {
          if (updateFrame) return;
          updateFrame = requestAnimationFrame(updateContents);
        };

        scrollRoot.addEventListener('scroll', scheduleContentsUpdate, { passive: true });
        window.addEventListener('resize', scheduleContentsUpdate);
        window.addEventListener('veli:docs-tab-change', scheduleContentsUpdate);
        scheduleContentsUpdate();
      }
    })();
  </script>
  <DocsCodeBlocks />
</Layout>
