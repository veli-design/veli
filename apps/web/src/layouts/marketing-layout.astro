---
import Layout from './layout.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import '../styles/marketing.css';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<Layout {title} {description} pageClass="marketing-page">
  <MarketingHeader />
  <main id="main"><slot /></main>
  <MarketingFooter />
</Layout>
<script>
  import { initMarketingPreferences } from '../scripts/marketing-preferences';
  initMarketingPreferences();
</script>
