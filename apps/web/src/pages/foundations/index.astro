---
import DocsLayout from '../../layouts/docs-layout.astro';
import { foundations } from '../../lib/site';

const headings = foundations.map((foundation) => ({
  depth: 2,
  slug: foundation.slug,
  text: foundation.title,
}));
---

<DocsLayout
  title="Foundations | Veli Design System"
  description="Principles, color, typography, spacing, motion, accessibility, language, and direction in Veli."
  activePath="/foundations/"
  {headings}
  fullBleedHeader
>
  <header class="docs-page-header docs-page-header--overview">
    <img
      class="docs-overview-hero"
      src="/images/foundations-overview.webp"
      alt=""
      width="2048"
      height="1152"
    />
    <div class="docs-page-header__content">
      <p class="docs-kicker">Foundations</p>
      <h1>The decisions beneath every service</h1>
      <p>
        Veli connects shared tokens, accessible components, and government service requirements into
        one design language.
      </p>
    </div>
  </header>

  <div class="foundation-directory">
    {
      foundations.map((foundation) => (
        <section id={foundation.slug}>
          <a href={foundation.href}>
            <div class="foundation-directory__icon" aria-hidden="true">
              <img
                src={foundation.icon}
                alt=""
                width={foundation.iconWidth}
                height={foundation.iconHeight}
                loading="lazy"
              />
            </div>
            <div class="foundation-directory__content">
              <h2>{foundation.title}</h2>
              <p>{foundation.description}</p>
            </div>
            <span class="foundation-directory__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </section>
      ))
    }
  </div>
</DocsLayout>
