---
import DocsLayout from '../../layouts/docs-layout.astro';
import { foundations } from '../../lib/site';

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  ...foundations.map((foundation) => ({
    depth: 2,
    slug: foundation.slug,
    text: foundation.title === 'Color' ? 'Colors' : foundation.title,
  })),
];
---

<DocsLayout
  title="Foundations | Veli Design System"
  description="Principles, color, typography, spacing, motion, accessibility, language, and direction in Veli."
  activePath="/foundations/"
  {headings}
  fullBleedHeader
>
  <header class="docs-page-header docs-page-header--overview docs-overview-header">
    <div class="docs-page-header__content">
      <h1>Veli Foundation</h1>
      <p>
        The operating beliefs behind Veli—clarity, access, local context, and shared foundations.
      </p>
    </div>
    <img
      class="docs-overview-hero"
      src="/images/foundations-overview-figma.png"
      alt=""
      width="1001"
      height="400"
    />
  </header>

  <div class="docs-overview-content">
    <section class="docs-overview-copy" id="overview">
      <h2>Overview</h2>
      <p>
        Veli’s foundations turn shared product values into practical design decisions. They define
        how services communicate hierarchy, respond to people, and stay coherent across languages,
        devices, and color schemes.
      </p>
      <p>
        Start here when making a system-level decision, then carry the guidance into components,
        patterns, and complete service experiences.
      </p>
    </section>

    <div class="foundation-directory docs-overview-directory">
      {
        foundations.map((foundation) => (
          <section id={foundation.slug}>
            <a href={foundation.href}>
              <div class="foundation-directory__icon" aria-hidden="true">
                <img
                  class="foundation-directory__icon-light"
                  src={foundation.icon}
                  alt=""
                  width={foundation.iconWidth}
                  height={foundation.iconHeight}
                  loading="lazy"
                />
                <img
                  class="foundation-directory__icon-dark"
                  src={foundation.iconDark}
                  alt=""
                  width={foundation.iconWidth}
                  height={foundation.iconHeight}
                  loading="lazy"
                />
              </div>
              <div class="foundation-directory__content">
                <h2>{foundation.title === 'Color' ? 'Colors' : foundation.title}</h2>
                <p>{foundation.description}</p>
              </div>
              <span class="foundation-directory__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </section>
        ))
      }
    </div>
  </div>
</DocsLayout>
