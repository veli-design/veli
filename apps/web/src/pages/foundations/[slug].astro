---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DocsPageActions from '../../components/DocsPageActions.astro';
import FoundationHeaderArt from '../../components/FoundationHeaderArt.astro';
import DocsLayout from '../../layouts/docs-layout.astro';

type Props = {
  foundation: CollectionEntry<'foundations'>;
};

export async function getStaticPaths() {
  const foundations = await getCollection('foundations');
  return foundations.map((foundation) => ({
    params: { slug: foundation.slug },
    props: { foundation },
  }));
}

const { foundation } = Astro.props as Props;
const { Content, headings } = await foundation.render();
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const markdownPath = `/foundations/${foundation.slug}/index.md`;
const headerArt = {
  principles: {
    src: '/images/foundation-headers/principles.png',
    srcDark: '/images/foundation-headers/principles-dark.png',
    lottie: '/images/foundation-headers/principles.lottie',
  },
  color: {
    src: '/images/foundation-headers/color.png',
    srcDark: '/images/foundation-headers/color-dark.png',
    lottie: '/images/foundation-headers/color.lottie',
    lottieDark: '/images/foundation-headers/color-dark.lottie',
  },
  typography: {
    src: '/images/foundation-headers/typography.png',
    srcDark: '/images/foundation-headers/typography-dark.png',
    lottie: '/images/foundation-headers/typography.lottie',
  },
  spacing: {
    src: '/images/foundation-headers/spacing.png',
    srcDark: '/images/foundation-headers/spacing-dark.png',
    lottie: '/images/foundation-headers/spacing.lottie',
  },
  motion: {
    src: '/images/foundation-headers/motion.png',
    srcDark: '/images/foundation-headers/motion-dark.png',
    lottie: '/images/foundation-headers/motion.lottie',
    lottieDark: '/images/foundation-headers/motion-dark.lottie',
  },
  accessibility: {
    src: '/images/foundation-headers/accessibility.png',
    srcDark: '/images/foundation-headers/accessibility-dark.png',
    lottie: '/images/foundation-headers/accessibility.lottie',
    lottieDark: '/images/foundation-headers/accessibility-dark.lottie',
  },
  'language-direction': {
    src: '/images/foundation-headers/language-direction.png',
    srcDark: '/images/foundation-headers/language-direction-dark.png',
    lottie: '/images/foundation-headers/language-direction.lottie',
  },
} as const;
const foundationHeaderArt = headerArt[foundation.slug as keyof typeof headerArt];
---

<DocsLayout
  title={`${foundation.data.title} | Veli Design System`}
  description={foundation.data.description}
  activePath={`/foundations/${foundation.slug}/`}
  {markdownPath}
  headings={tocHeadings}
>
  <header
    class:list={[
      'docs-page-header',
      'docs-page-header--article',
      foundationHeaderArt && 'docs-page-header--illustrated',
    ]}
  >
    <div class="docs-page-header__copy">
      <h1>{foundation.data.title}</h1>
      {foundation.data.description && <p>{foundation.data.description}</p>}
      <DocsPageActions {markdownPath} placement="inline" />
    </div>
    {
      foundationHeaderArt && (
        <FoundationHeaderArt
          src={foundationHeaderArt.src}
          srcDark={foundationHeaderArt.srcDark}
          lottie={foundationHeaderArt.lottie}
          lottieDark={
            'lottieDark' in foundationHeaderArt ? foundationHeaderArt.lottieDark : undefined
          }
        />
      )
    }
  </header>

  <article class="docs-prose foundation-prose">
    <Content />
  </article>
</DocsLayout>
