---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DocsPageActions from '../../components/DocsPageActions.astro';
import DocsLayout from '../../layouts/docs-layout.astro';

type Props = {
  foundation: CollectionEntry<'foundations'>;
};

export async function getStaticPaths() {
  const foundations = await getCollection('foundations');
  return foundations.map((foundation) => ({
    params: { slug: foundation.slug },
    props: { foundation },
  }));
}

const { foundation } = Astro.props as Props;
const { Content, headings } = await foundation.render();
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const markdownPath = `/foundations/${foundation.slug}/index.md`;
const headerArt = {
  color: {
    src: '/images/foundation-headers/color.png',
    width: 148,
    height: 134,
  },
  typography: {
    src: '/images/foundation-headers/typography.png',
    width: 197,
    height: 178,
  },
} as const;
const foundationHeaderArt = headerArt[foundation.slug as keyof typeof headerArt];
---

<DocsLayout
  title={`${foundation.data.title} | Veli Design System`}
  description={foundation.data.description}
  activePath={`/foundations/${foundation.slug}/`}
  {markdownPath}
  headings={tocHeadings}
>
  <header
    class:list={[
      'docs-page-header',
      'docs-page-header--article',
      foundationHeaderArt && 'docs-page-header--illustrated',
    ]}
  >
    <div class="docs-page-header__copy">
      <h1>{foundation.data.title}</h1>
      {foundation.data.description && <p>{foundation.data.description}</p>}
      <DocsPageActions {markdownPath} />
    </div>
    {
      foundationHeaderArt && (
        <img
          class="docs-page-header__art"
          src={foundationHeaderArt.src}
          alt=""
          width={foundationHeaderArt.width}
          height={foundationHeaderArt.height}
        />
      )
    }
  </header>

  <article class="docs-prose foundation-prose">
    <Content />
  </article>
</DocsLayout>
