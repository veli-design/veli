---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { blocks, blockPages } from '../../../lib/blocks';
import DocsLayout from '../../../layouts/docs-layout.astro';
import DocsPageActions from '../../../components/DocsPageActions.astro';
import rehypeCodeBlocks from '../../../lib/rehype-code-blocks.mjs';

// Cache one processor/highlighter for all block pages — Shiki is a singleton and
// creating a new instance per request leaks and can fail on large block markdown.
const blockMarkdownProcessor = await createMarkdownProcessor({
  rehypePlugins: [rehypeCodeBlocks],
});

export function getStaticPaths() {
  return blocks.map(({ manifest }) => ({ params: { slug: manifest.id } }));
}
const page = blockPages.find((page) => page.id === `blocks/${Astro.params.slug}`)!;
const rendered = await blockMarkdownProcessor.render(page.markdown.replace(/^# .*\n/, ''));
const markdownPath = `/docs/${page.id}/index.md`;
const slug = Astro.params.slug;
---

<DocsLayout
  title={`${page.title} | Veli Design System`}
  description={page.description}
  activePath={`/docs/${page.id}/`}
  {markdownPath}
  headings={rendered.metadata.headings.filter((h) => h.depth === 2 || h.depth === 3)}
  contentLayout="article"
>
  <header class="docs-page-header docs-page-header--article">
    <h1>{page.title}</h1>
    <p>{page.description}</p>
    <DocsPageActions {markdownPath} placement="inline" />
  </header>
  <figure class="block-preview">
    <img
      class="block-preview__image block-preview__image--light"
      src={`/images/blocks/${slug}-light.png`}
      alt={`${page.title} block, light theme`}
      loading="lazy"
      decoding="async"
    />
    <img
      class="block-preview__image block-preview__image--dark"
      src={`/images/blocks/${slug}-dark.png`}
      alt={`${page.title} block, dark theme`}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <article class="docs-prose block-preview-prose" set:html={rendered.code} />
</DocsLayout>

<style>
  /* The article layout places .docs-prose in grid row 2. Pin the preview to that row and move
     the article below it so the screenshots render at the top of the page. */
  .block-preview {
    grid-column: 1;
    grid-row: 2;
    margin: 42px 0 0;
  }

  .block-preview-prose {
    grid-row: 3;
  }

  /* Keep the table of contents beside the article, not stretched down the preview row. */
  :global(.docs-main--article:has(.block-preview) .docs-utilities) {
    grid-row: 3;
  }

  .block-preview__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .block-preview__image--dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .block-preview__image--light {
    display: none;
  }

  :global(:root[data-theme='dark']) .block-preview__image--dark {
    display: block;
  }
</style>
