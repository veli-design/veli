---
import { getEntry } from 'astro:content';
import DocsLayout from '../../layouts/docs-layout.astro';
import '../../styles/get-started.css';

const guide = await getEntry('guides', 'get-started');
if (!guide) throw new Error('Get Started guide is missing');
const { Content, headings } = await guide.render();
---

<DocsLayout
  title="Get Started | Veli Design System"
  description={guide.data.description}
  activePath="/docs/"
  markdownPath="/docs/index.md"
  contentLayout="get-started"
  headings={headings.filter((heading) => heading.depth === 2)}
  showPageActions={false}
>
  <header class="docs-page-header get-started-header">
    <h1>{guide.data.title}</h1>
    <p>{guide.data.description}</p>
  </header>
  <article class="docs-prose get-started-content"><Content /></article>
</DocsLayout>
