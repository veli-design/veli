---
import DocsLayout from '../../layouts/docs-layout.astro';
import DocsPageActions from '../../components/DocsPageActions.astro';
import { docsSections } from '../../lib/site';
---

<DocsLayout
  title="Documentation | Veli Design System"
  description="Start building accessible, bilingual public services with Veli foundations, components, patterns, and blocks."
  activePath="/docs/"
  markdownPath="/docs/index.md"
  contentLayout="overview"
>
  <header class="docs-page-header docs-page-header--overview">
    <div class="docs-page-header__content">
      <h1>Build with Veli</h1>
      <p>One shared foundation for accessible, bilingual public services.</p>
      <DocsPageActions markdownPath="/docs/index.md" placement="inline" />
    </div>
  </header>
  <div class="docs-overview-content">
    <section class="docs-overview-copy">
      <h2>Start with the system</h2>
      <p>
        Explore the foundations, choose accessible components, and bring them together with tested
        patterns and ready-made blocks.
      </p>
    </section>
    <div class="docs-link-list">
      {
        docsSections.map((section) => (
          <a href={section.href}>
            <span>{section.title}</span>
            <p>
              {
                {
                  foundations:
                    'Principles, colour, typography, spacing, motion, and accessibility.',
                  components:
                    'Accessible React building blocks, usage guidance, and API references.',
                  patterns: 'Recurring service interactions, forms, and content flows.',
                  blocks: 'Editable page sections that you can copy into your application.',
                }[section.id]
              }
            </p>
          </a>
        ))
      }
    </div>
  </div>
</DocsLayout>
