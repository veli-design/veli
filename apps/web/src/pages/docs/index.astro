---
import DocsPageActions from '../../components/DocsPageActions.astro';
import DocsLayout from '../../layouts/docs-layout.astro';
import { componentGroups, docsOverview, getComponentGroupSlug } from '../../lib/site';

const headings = [
  ...componentGroups.map((group) => ({
    depth: 2,
    slug: getComponentGroupSlug(group.title),
    text: group.title,
  })),
];
const markdownPath = docsOverview.markdownPath;
---

<DocsLayout
  title={docsOverview.documentTitle}
  description={docsOverview.documentDescription}
  activePath={docsOverview.htmlPath}
  {markdownPath}
  {headings}
  fullBleedHeader
>
  <header class="docs-page-header docs-page-header--overview">
    <img
      class="docs-overview-hero"
      src="/images/components-overview.webp"
      alt=""
      width="2048"
      height="1163"
    />
    <div class="docs-page-header__content">
      <p class="docs-kicker">{docsOverview.kicker}</p>
      <h1>{docsOverview.title}</h1>
      <p class="docs-page-description">{docsOverview.description}</p>
      <DocsPageActions {markdownPath} />
    </div>
  </header>

  <div class="docs-intro-links">
    <a href="/foundations/">
      <span>Foundations</span>
      <small>Principles, color, type, spacing, accessibility, and language.</small>
    </a>
  </div>

  {
    componentGroups.map((group) => {
      const id = getComponentGroupSlug(group.title);
      return (
        <section class="docs-list-section" id={id}>
          <h2>{group.title}</h2>
          <div class="docs-link-list">
            {group.items.map((item) => (
              <a href={`/docs/${item.slug}/`}>
                <span>{item.title}</span>
                <p>{item.description}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</DocsLayout>
