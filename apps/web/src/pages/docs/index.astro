---
import DocsLayout from '../../layouts/docs-layout.astro';
import { componentGroups } from '../../lib/site';

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  ...componentGroups.map((group) => ({
    depth: 2,
    slug: group.title.toLowerCase().replaceAll(' ', '-').replace('&', 'and'),
    text: group.title,
  })),
];
---

<DocsLayout
  title="Documentation | Veli Design System"
  description="Foundations and component documentation for the Veli Design System."
  activePath="/docs/"
  {headings}
  fullBleedHeader
>
  <header class="docs-page-header docs-page-header--overview docs-overview-header">
    <div class="docs-page-header__content">
      <h1>Veli Components</h1>
      <p>Accessible building blocks for consistent, dependable public-service interfaces.</p>
    </div>
    <img
      class="docs-overview-hero"
      src="/images/components-overview.webp"
      alt=""
      width="2048"
      height="1163"
    />
  </header>

  <div class="docs-overview-content">
    <section class="docs-overview-copy" id="overview">
      <h2>Overview</h2>
      <p>
        Veli components pair accessible behavior with the visual decisions defined by the system’s
        foundations. Each reference covers the supported interface, states, and composition guidance
        needed to use a component with confidence.
      </p>
      <p>
        Choose the component that communicates the interaction most directly, and prefer documented
        variants before creating local conventions.
      </p>
    </section>

    <div class="docs-overview-directory">
      {
        componentGroups.map((group) => {
          const id = group.title.toLowerCase().replaceAll(' ', '-').replace('&', 'and');
          return (
            <section class="docs-list-section" id={id}>
              <h2>{group.title}</h2>
              <div class="docs-link-list">
                {group.items.map((item) => (
                  <a href={`/docs/${item.slug}/`}>
                    <span>{item.title}</span>
                    <p>{item.description}</p>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</DocsLayout>
