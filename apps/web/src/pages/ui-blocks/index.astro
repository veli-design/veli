---
import { SquaresFour } from 'phosphor-react';
import DocsLayout from '../../layouts/docs-layout.astro';

const headings = [{ depth: 2, slug: 'overview', text: 'Overview' }];
---

<DocsLayout
  title="UI Blocks | Veli Design System"
  description="Larger interface compositions built from Veli components and patterns."
  activePath="/ui-blocks/"
  {headings}
  fullBleedHeader
>
  <header class="docs-page-header docs-page-header--overview docs-overview-header">
    <div class="docs-page-header__content">
      <h1>Veli UI Blocks</h1>
      <p>Complete interface compositions for familiar public-service tasks.</p>
    </div>
    <div class="docs-overview-hero docs-overview-hero--placeholder" aria-hidden="true">
      <SquaresFour size={72} weight="duotone" />
    </div>
  </header>

  <div class="docs-overview-content">
    <section class="docs-overview-copy docs-coming-soon" id="overview">
      <p class="docs-kicker">Coming soon</p>
      <h2>Overview</h2>
      <p>
        UI Blocks will provide ready-to-adapt compositions for common service surfaces while keeping
        their structure, behavior, and accessibility requirements visible.
      </p>
    </section>
  </div>
</DocsLayout>
