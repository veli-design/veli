---
import MarketingLayout from '../layouts/marketing-layout.astro';
import { Button } from '@veli-design/react/button';
const a = '/images/marketing/';
const features = [
  {
    title: 'Ready to use',
    description: 'Pre-built components and templates, so teams never start from scratch.',
    image: 'c11d0.png',
    width: 717,
    height: 287,
  },
  {
    title: 'Consistent by design',
    description: 'Shared guidelines give every government service a familiar look and feel.',
    image: 'e221e.png',
    width: 699,
    height: 291,
  },
  {
    title: 'Built for everyone',
    description: 'Access services on any device, in Dhivehi or English.',
    image: '9ab51.png',
    width: 919,
    height: 432,
  },
];
const explore = [
  {
    title: 'Foundations',
    slug: 'foundations',
    icon: '7cc01.svg',
    description: 'Colour, type, spacing and motion: the shared tokens behind every service.',
  },
  {
    title: 'Components',
    slug: 'components',
    icon: '00a3c.svg',
    description: 'Accessible, bilingual building blocks, from buttons to date pickers.',
  },
  {
    title: 'Patterns',
    slug: 'patterns',
    icon: '075b1.svg',
    description: 'Tested ways to ask questions, check answers and handle errors.',
  },
  {
    title: 'Blocks',
    slug: 'blocks',
    icon: '0aced.svg',
    description: 'Ready-made page sections, like start pages, to assemble a service fast.',
  },
];
const palettes = [
  [
    '#f0ffef',
    '#d5ffd3',
    '#bdfdb4',
    '#9af366',
    '#5ed423',
    '#2fb31e',
    '#0fa320',
    '#227b0d',
    '#225d04',
    '#1a3d02',
    '#0e2801',
    '#051500',
  ],
  [
    '#f9fdfc',
    '#eaf7f5',
    '#d6f3f0',
    '#b0ecea',
    '#5bccca',
    '#3babae',
    '#309a9f',
    '#19767e',
    '#055964',
    '#0c3a47',
    '#0f2528',
    '#051214',
  ],
  [
    '#f8fdff',
    '#e6f7ff',
    '#d4f2ff',
    '#b7e9fe',
    '#5ac6fd',
    '#13a4f4',
    '#0091ed',
    '#0065de',
    '#003fd1',
    '#002a8f',
    '#001d58',
    '#010f2d',
  ],
  [
    '#fcfbff',
    '#f6f4ff',
    '#eeeaff',
    '#e4ddff',
    '#c1b0ff',
    '#a28afe',
    '#9177fd',
    '#6d4bf0',
    '#4934c5',
    '#301f86',
    '#21125f',
    '#10053b',
  ],
];
---

<MarketingLayout
  title="Veli Design — Maldives Government Design System"
  description="Veli gives every government team the same building blocks, so services are faster to build and easier to use."
>
  <div class="marketing-home">
    <canvas id="field" aria-hidden="true"></canvas>
    <section class="marketing-home-hero" aria-labelledby="home-title" data-field-cover>
      <h1 id="home-title">
        <img
          class="marketing-hero-logo"
          src={`${a}veli-design-hero.svg`}
          width="961"
          height="154"
          alt="Veli Design"
          data-solid="rect"
          data-group="logo"
        />
      </h1>
    </section>
    <div class="marketing-container marketing-home-content">
      <section class="marketing-statement" aria-labelledby="home-statement">
        <h2 id="home-statement" data-field-stop>
          Helping teams deliver consistent digital experiences.
        </h2>
        <p>
          Veli gives every government team the same building blocks, so services are faster to build
          and easier to use.
        </p>
        <Button as="a" href="/docs/" intent="accent" size="xl">Documentation</Button>
      </section>
      <div class="marketing-feature-grid">
        {
          features.map((feature, index) => (
            <article class:list={['marketing-feature', index === 2 && 'marketing-feature-wide']}>
              <div class="marketing-feature-art" aria-hidden="true">
                <img
                  src={`${a}${feature.image}`}
                  width={feature.width}
                  height={feature.height}
                  loading="lazy"
                  alt=""
                />
              </div>
              <div class="marketing-feature-copy">
                <>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <section class="marketing-foundations" aria-labelledby="foundation-title">
        <div class="marketing-statement">
          <h2 id="foundation-title">Unified foundation,<br />Streamlined Design</h2><p>
            Veli design system foundations focus on consistent colors, clear typography, and
            purposeful motion inspired by the Maldives islands and its formation.
          </p><Button as="a" href="/docs/foundations/" intent="accent" size="xl">Foundation</Button>
        </div>
        <div class="marketing-foundation-grid">
          <a
            class="marketing-foundation-tile marketing-palette"
            href="/docs/foundations/color/"
            aria-label="Explore Veli colour"
            ><div aria-hidden="true">
              {
                palettes.map((row) => (
                  <div>
                    {row.map((color) => (
                      <span style={{ backgroundColor: color }} />
                    ))}
                  </div>
                ))
              }
            </div></a
          >
          <a
            class="marketing-foundation-tile marketing-type"
            href="/docs/foundations/typography/"
            aria-label="Explore Veli typography"
            ><img src={`${a}eabed.svg`} width="316" height="56" alt="Dhivehi Raajje" /><span
              >Maldives</span
            ></a
          >
          <a
            class="marketing-foundation-tile marketing-motion-art"
            href="/docs/foundations/motion/"
            aria-label="Explore purposeful motion"
            ><img src={`${a}b0208.svg`} width="180" height="180" alt="" /><span
              class="marketing-motion-track"
              ><img src={`${a}5d2fc.svg`} width="239" height="8" alt="" /><img
                class="marketing-motion-ball"
                src={`${a}6a7aa.svg`}
                width="24"
                height="24"
                alt=""
              /></span
            ></a
          >
          <a
            class="marketing-foundation-tile marketing-spacing"
            href="/docs/foundations/spacing/"
            aria-label="Explore Veli spacing"
            >{Array.from({ length: 8 }, () => <span aria-hidden="true" />)}</a
          >
        </div>
      </section>
      <section class="marketing-adoption" aria-label="Government adoption">
        <p>
          Veli Design System launches with 15+ services already on board, across every ministry in
          the Cabinet.
        </p><div class="marketing-logo-strip">
          <img src={`${a}govmv-wordmark.svg`} width="132" height="34" alt="gov.mv" />{
            Array.from({ length: 4 }, () => (
              <div>
                <>
                  <img src={`${a}government-emblem.svg`} width="40" height="46" alt="" />
                  <span>
                    Ministry of Homeland Security,
                    <br />
                    Labour and Technology
                  </span>
                </>
              </div>
            ))
          }
        </div>
      </section>
      <section class="marketing-explore" aria-labelledby="explore-title">
        <div class="marketing-statement">
          <h2 id="explore-title">Everything you need,<br />all in one place</h2>
        </div><div class="marketing-explore-grid">
          {
            explore.map((item) => (
              <a href={`/docs/${item.slug}/`}>
                <>
                  <div class="marketing-explore-icon">
                    <img
                      src={`${a}${item.icon}`}
                      width={item.slug === 'components' || item.slug === 'blocks' ? 148 : 144}
                      height={item.slug === 'components' ? 142 : item.slug === 'blocks' ? 136 : 144}
                      loading="lazy"
                      alt=""
                    />
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </>
              </a>
            ))
          }
        </div>
      </section>
      <section class="marketing-contribute" aria-labelledby="contribute-title">
        <img src={`${a}30c84.svg`} width="2058" height="1644" loading="lazy" alt="" /><div>
          <h2 id="contribute-title">Let’s build it<br />together</h2><p>
            Whether you’re a designer, developer, or government team,<br
              class="marketing-desktop-break"
            /> your contributions can help make public services clearer, more consistent, and accessible
            to everyone.
          </p><Button
            as="a"
            href="https://github.com/veli-design/veli/blob/main/CONTRIBUTING.md"
            intent="accent"
            size="xl">Contribute to Veli</Button
          >
        </div>
      </section>
    </div>
  </div>
</MarketingLayout>
<script>
  import { initHomeStipple } from '../scripts/home-stipple.js';
  initHomeStipple();
</script>
