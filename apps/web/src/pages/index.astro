---
import MarketingLayout from '../layouts/marketing-layout.astro';
import HomeHeroLogo from '../components/marketing/HomeHeroLogo.astro';
import HomeExploreIcon from '../components/marketing/HomeExploreIcon.astro';
import govmv from '../assets/marketing/home-govmv.svg?raw';
import { Button } from '@veli-design/react/button';
import '../styles/home-experience.css';

const a = '/images/marketing/';
const features = [
  {
    title: 'Ready to use',
    name: 'ready-to-use',
    solids: 'rtu-search rtu-filter rtu-label',
    description: 'Pre-built components and templates, so teams never start from scratch.',
    image: 'c11d0.png',
    width: 717,
    height: 287,
  },
  {
    title: 'Consistent by design',
    name: 'consistent-by-design',
    solids: 'cbd-sheet',
    description: 'Shared guidelines give every government service a familiar look and feel.',
    image: 'e221e.png',
    width: 699,
    height: 291,
  },
  {
    title: 'Built for everyone',
    name: 'built-for-everyone',
    solids: 'bfe-card',
    description: 'Access services on any device, in Dhivehi or English.',
    image: '9ab51.png',
    width: 919,
    height: 432,
  },
];
const explore = [
  {
    title: 'Foundations',
    slug: 'foundations',
    description: 'Colour, type, spacing and motion: the shared tokens behind every service.',
  },
  {
    title: 'Components',
    slug: 'components',
    description: 'Accessible, bilingual building blocks, from buttons to date pickers.',
  },
  {
    title: 'Patterns',
    slug: 'patterns',
    description: 'Tested ways to ask questions, check answers and handle errors.',
  },
  {
    title: 'Blocks',
    slug: 'blocks',
    description: 'Ready-made page sections, like start pages, to assemble a service fast.',
  },
] as const;
const foundations = [
  ['colour', 'color', 'Explore Veli colour'],
  ['type', 'typography', 'Explore Veli typography'],
  ['motion', 'motion', 'Explore purposeful motion'],
  ['grid', 'spacing', 'Explore Veli spacing'],
];
---

<MarketingLayout
  title="Veli Design — Maldives Government Design System"
  description="Veli gives every government team the same building blocks, so services are faster to build and easier to use."
>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      let preference = null;
      try {
        preference = localStorage.getItem('veli-reduced-motion');
      } catch {
        /* Use the system preference. */
      }
      const reduced =
        preference === null
          ? matchMedia('(prefers-reduced-motion: reduce)').matches
          : preference === 'true';
      if (!reduced && window.scrollY < 40) root.classList.add('home-intro');
      setTimeout(() => {
        if (!root.dataset.homeReady) root.classList.remove('home-intro');
      }, 8000);
    })();
  </script>
  <div class="marketing-home">
    <canvas id="field" aria-hidden="true"></canvas>
    <section class="marketing-home-hero" aria-labelledby="home-title" data-field-cover>
      <h1 id="home-title"><HomeHeroLogo /></h1>
    </section>
    <div class="marketing-container marketing-home-content">
      <section class="marketing-statement" aria-labelledby="home-statement">
        <h2 id="home-statement" data-intro data-solid="text" data-group="text" data-field-stop>
          Helping teams deliver consistent digital experiences.
        </h2>
        <p data-intro data-solid="text" data-group="text">
          Veli gives every government team the same building blocks, so services are faster to build
          and easier to use.
        </p>
        <div data-intro data-solid="rect" data-group="text">
          <Button as="a" href="/docs/" intent="accent" size="xl">Get Started</Button>
        </div>
      </section>
      <section class="marketing-feature-grid cards-v2" aria-label="Principles" data-reveal>
        {
          features.map((feature, index) => (
            <article
              class:list={[
                'marketing-feature',
                'pcard',
                index === 2 && 'marketing-feature-wide',
                index === 2 && 'wide',
              ]}
              data-card={index + 1}
              data-reveal-item
              data-solid="rect"
              data-group="cards"
            >
              <div
                class="marketing-feature-art anim"
                aria-hidden="true"
                data-lottie={feature.name}
                data-lottie-solids={feature.solids}
                data-lottie-align={index === 2 ? 'xMidYMin' : undefined}
                data-stipple
                data-stipple-key={`stPattern${index + 1}`}
                data-stipple-color-key={`cardHover${index + 1}`}
              >
                <img
                  class="marketing-animation-fallback"
                  src={`${a}${feature.image}`}
                  width={feature.width}
                  height={feature.height}
                  loading="lazy"
                  alt=""
                />
                <div class="lottie-box" />
              </div>
              <button
                class="lt-replay"
                type="button"
                aria-label={`Replay the ${feature.title} animation`}
                hidden
              >
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                  <path
                    d="M16.7 10a6.7 6.7 0 1 1-1.9-4.7M15 2v4h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="marketing-feature-copy head">
                <h3 data-cf-avoid>{feature.title}</h3>
                <p data-cf-avoid>{feature.description}</p>
              </div>
            </article>
          ))
        }
      </section>
      <section class="marketing-foundations foundation" aria-labelledby="foundation-title">
        <div class="marketing-statement" data-reveal>
          <h2 id="foundation-title" data-reveal-item>
            Unified foundation,<br />Streamlined Design
          </h2>
          <p data-reveal-item>
            Veli design system foundations focus on consistent colors, clear typography, and
            purposeful motion inspired by the Maldives islands and its formation.
          </p>
          <div data-reveal-item>
            <Button as="a" href="/docs/foundations/" intent="accent" size="xl">Foundation</Button>
          </div>
        </div>
        <div class="marketing-foundation-grid fd-grid">
          {
            foundations.map(([kind, slug, label]) => (
              <article class="fcard">
                <div
                  class="fd-panel"
                  data-fd={kind}
                  role="button"
                  tabindex="0"
                  aria-label={`${label} preview; replay animation`}
                />
                <a class="home-foundation-fallback" href={`/docs/foundations/${slug}/`}>
                  {label}
                </a>
              </article>
            ))
          }
        </div>
      </section>
      <section class="marketing-adoption logos" aria-label="Government adoption">
        <p class="lg-line">
          Veli Design System launches with 15+ services already on board, across every ministry in
          the Cabinet.
        </p>
        <div class="lg-window">
          <ul class="lg-track">
            <li class="lg-item"><Fragment set:html={govmv} /></li>
            {
              Array.from({ length: 5 }, (_, index) => (
                <li class="lg-item" aria-hidden={index > 0 ? 'true' : undefined}>
                  <img
                    class="lg-emblem"
                    src={`${a}adoption-emblem.png`}
                    width="35"
                    height="40"
                    alt=""
                    loading="lazy"
                  />
                  <span>Minister of Homeland Security, Labour and Technology</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
      <section class="marketing-explore" aria-labelledby="explore-title" data-reveal>
        <div class="marketing-statement" data-reveal-item>
          <h2 id="explore-title">Everything you need,<br />all in one place</h2>
        </div>
        <div class="marketing-explore-grid explore">
          {
            explore.map((item) => (
              <a class="xcol" href={`/docs/${item.slug}/`} data-reveal-item>
                <span class="xi-box">
                  <HomeExploreIcon kind={item.slug} />
                </span>
                <span class="head">
                  <h3>
                    {item.title}
                    <svg class="xc" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                      <path
                        d="m7.5 5 5 5-5 5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </h3>
                  <p>{item.description}</p>
                </span>
              </a>
            ))
          }
        </div>
      </section>
      <section class="marketing-contribute" aria-labelledby="contribute-title" data-cta="light">
        <div class="cta-light-src" aria-hidden="true">
          <img src={`${a}30c84.svg`} width="2058" height="1644" loading="lazy" alt="" />
        </div>
        <div class="marketing-contribute-copy">
          <h2 id="contribute-title">Let’s build it<br />together</h2>
          <p>
            Whether you’re a designer, developer, or government team,<br
              class="marketing-desktop-break"
            />
            your contributions can help make public services clearer, more consistent, and accessible
            to everyone.
          </p>
          <div data-cta-item>
            <Button
              as="a"
              href="https://github.com/veli-design/veli/blob/main/CONTRIBUTING.md"
              intent="accent"
              size="xl">Contribute to Veli</Button
            >
          </div>
        </div>
      </section>
    </div>
  </div>
</MarketingLayout>
<script>
  import { initHomeExperience } from '../scripts/home-experience.js';
  initHomeExperience();
</script>
