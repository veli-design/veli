---
import Layout from '../layouts/layout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import VeliLogo from '../components/VeliLogo.astro';
---

<Layout
  title="Veli Design System"
  description="Veli gives every Maldivian service one accessible, bilingual system to build from."
  pageClass="home-page"
>
  <main id="main" class="home-hero">
    <ShaderBackground
      class="home-hero__background"
      shader="veli-aurora"
      fallbackSrc="/images/veli-home-background.png"
    />
    <div class="home-hero__content">
      <div class="home-wordmark">
        <VeliLogo class="veli-logo" clipId="veli-logo-home" label="Veli Design" />
      </div>

      <div class="home-copy">
        <h1>The foundation for<br />public services</h1>
        <p>
          Government services are outgrowing scattered interfaces.<br />
          Veli gives every Maldivian service one accessible, bilingual system to build from.
        </p>
      </div>

      <a class="home-cta" href="/docs/">Start building</a>
    </div>
  </main>
</Layout>
