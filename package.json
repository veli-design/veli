{
  "name": "veli",
  "version": "1.0.0",
  "private": true,
  "description": "Veli Design System Monorepo",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --cache --cache-location .cache/eslint/ --cache-strategy content --max-warnings 0",
    "lint:fix": "corepack pnpm lint --fix",
    "format": "prettier . --write --cache --cache-strategy content",
    "format:check": "prettier . --check --cache --cache-strategy content",
    "check": "corepack pnpm changeset:check && corepack pnpm test:changesets && corepack pnpm test:agent-eval && corepack pnpm test:tokens && corepack pnpm test:ui && corepack pnpm test:blocks && corepack pnpm test:cli && corepack pnpm format:check && corepack pnpm lint && corepack pnpm test:veli-lint && corepack pnpm lint:veli && corepack pnpm build",
    "changeset": "node scripts/create-changeset.mjs",
    "changeset:check": "node scripts/check-changesets.mjs",
    "changeset:raw": "changeset",
    "test:changesets": "node --test scripts/*.test.mjs",
    "test:agent-eval": "node --test evals/agent/score.test.mjs",
    "eval:agent": "node evals/agent/score.mjs",
    "eval:agent:prepare": "node evals/agent/prepare.mjs",
    "eval:agent:matrix": "node evals/agent/matrix.mjs",
    "check:agent-sidecar-drift": "node scripts/check-agent-sidecar-drift.mjs",
    "test:ui": "pnpm --filter @veli-design/react test",
    "version-packages": "node scripts/version-packages.mjs",
    "release": "node scripts/publish-packages.mjs",
    "prepare": "husky",
    "test:blocks": "corepack pnpm --filter @tradenetcorp/veli-blocks test",
    "test:blocks:consumer": "corepack pnpm --filter @tradenetcorp/veli-blocks test:consumer",
    "test:cli": "corepack pnpm --filter @veli-design/cli test",
    "test:tokens": "corepack pnpm --filter @veli-design/tokens test",
    "lint:veli": "eslint --config eslint.veli.config.mjs --no-warn-ignored apps packages/blocks/src",
    "test:veli-lint": "node --test scripts/lint/*.test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{md,mdx,css,json,jsonc,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@changesets/get-release-plan": "^4.0.16",
    "@changesets/parse": "^0.4.3",
    "@clack/prompts": "^0.9.1",
    "@eslint/js": "^9.39.4",
    "@manypkg/get-packages": "^1.1.3",
    "@shadcn/lint": "0.2.3",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "1.72.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "semver": "7.7.3",
    "turbo": "^2.10.7",
    "typescript-eslint": "^8.59.3",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradenetcorp/veli.git",
    "directory": "."
  },
  "homepage": "https://github.com/tradenetcorp/veli#readme",
  "bugs": {
    "url": "https://github.com/tradenetcorp/veli/issues"
  },
  "keywords": [
    "veli",
    "design-system"
  ]
}
